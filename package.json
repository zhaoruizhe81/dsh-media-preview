{
  "name": "@local/dsh-media-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preview video and audio files inline in the right-sidebar document preview.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoruizhe81-bot/dsh-media-preview.git"
  },
  "homepage": "https://github.com/zhaoruizhe81-bot/dsh-media-preview#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "video",
    "audio",
    "preview"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
